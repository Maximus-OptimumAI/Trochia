# Trochia AI — environment variables (Phase 1 full list)
# Copy to .env.local and fill in real values. NEVER commit real values.
# Later plans inject real values into .env.local + Vercel env — they do NOT re-edit this file.

# ── Site URLs (FND-08: site URLs ONLY come from these — never hardcoded) ──
# Build:      https://trochia.asranest.com
# Production: https://trochia.ai  (post domain acquisition — env swap only)
NEXT_PUBLIC_SITE_URL=https://trochia.asranest.com
NEXT_PUBLIC_APP_URL=https://trochia.asranest.com

# ── Database (Supabase Postgres) ──
# Pooled connection for the app; direct connection for migrations.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ── Supabase (use the NEW publishable/secret keys — never anon/service_role) ──
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRE_RAISE_MONTHLY=price_...
STRIPE_PRICE_PRE_RAISE_ANNUAL=price_...
STRIPE_PRICE_ACTIVE_RAISE_MONTHLY=price_...
STRIPE_PRICE_ACTIVE_RAISE_ANNUAL=price_...

# ── AI chokepoint (Anthropic primary; OpenAI/Codex fallback behind a flag) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_FALLBACK_ENABLED=false

# ── Langfuse (every production Anthropic call is traced) ──
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Sentry ──
SENTRY_DSN=https://[KEY]@[ORG].ingest.sentry.io/[PROJECT]
NEXT_PUBLIC_SENTRY_DSN=https://[KEY]@[ORG].ingest.sentry.io/[PROJECT]
SENTRY_ORG=trochia
SENTRY_PROJECT=trochia
SENTRY_AUTH_TOKEN=sntrys_...

# ── Amplitude (product analytics incl. the onboarding funnel) ──
AMPLITUDE_API_KEY=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ── Resend (transactional email) ──
RESEND_API_KEY=re_...
EMAIL_FROM=Trochia <hello@trochia.asranest.com>

# ── Inngest (background jobs — single app, single /api/inngest endpoint) ──
INNGEST_SIGNING_KEY=signkey-...
INNGEST_EVENT_KEY=

# ── Upstash Redis (rate limiting) ──
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Playwright (CI sets this to the Vercel preview URL) ──
# PLAYWRIGHT_BASE_URL=http://localhost:3000
